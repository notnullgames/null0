#load "null0.onyx"

// onyx needs a main, even though null0 never calls it
main :: () {}

load :: () {
    clear(BLUE);
    draw_circle(100, 100, 50, RED);
    // a string crosses as a pointer to null-terminated utf8; cstr() from the
    // bindings does that conversion
    draw_text(FONT_DEFAULT, cstr("hello from Onyx"), 170, 92, WHITE);
}

#export "load" load

// callbacks (optional - implement as needed)
