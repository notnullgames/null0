const BLANK: i32 = 65628; // rgba(0, 0, 0, 0)
// i32.store8(65628, 0); i32.store8(65629, 0); i32.store8(65630, 0); i32.store8(65631, 0);
const MAGENTA: i32 = 65632; // rgba(255, 0, 255, 255)
// i32.store8(65632, 255); i32.store8(65633, 0); i32.store8(65634, 255); i32.store8(65635, 255);
const RAYWHITE: i32 = 65636; // rgba(245, 245, 245, 255)
// i32.store8(65636, 245); i32.store8(65637, 245); i32.store8(65638, 245); i32.store8(65639, 255);


