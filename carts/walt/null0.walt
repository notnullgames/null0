// Get a custom property of a tile of a tilemap, by index (PROP_NONE when out of range.)
type TileGidPropAt = (i32, i32, i32) => i32;
// import { tile_gid_prop_at: TileGidPropAt } from 'null0';
// Get the number of objects on an object-layer of a tilemap.
type TileObjectCount = (i32, i32) => i32;
// import { tile_object_count: TileObjectCount } from 'null0';
// Get an object from an object-layer of a tilemap.
type TileObject = (i32, i32, i32) => i32;
// import { tile_object: TileObject } from 'null0';
