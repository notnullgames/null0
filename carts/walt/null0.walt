type TileObjectProp = (i32, i32, i32, i32) => i32;
// import { tile_object_prop: TileObjectProp } from 'null0';
// Get the number of custom properties on an object of a tilemap.
type TileObjectPropCount = (i32, i32, i32) => i32;
