// null0 Zen-C demo: shapes, a Vector[] polygon, text, and animation state
//
// draw_polygon (and its 3 siblings) take `i32* points, u8* color` here
// instead of `Vector*, Color` - null0.h generates them that way for zc
// specifically, since zc v0.4.4's own compiler segfaults on any cart-authored
// declaration naming Color/Vector/Rectangle/Dimensions/SfxParams (see the
// comment at the top of tools/gen_cart_zenc.js). Plain int/byte arrays like
// the ones below don't trip it.
include "null0.h"

let frame: int = 0;

export fn update() {
    frame += 1;

    clear(DARKGRAY);
    draw_text(FONT_DEFAULT, "null0 demo", 20, 20, WHITE);
    draw_rectangle(40, 80, 100, 70, RED);
    draw_circle(220, 115, 45, GREEN);
    draw_triangle(320, 150, 400, 150, 360, 60, BLUE);
    draw_line(40, 250, 600, 250, LIGHTGRAY);

    // hexagon - the Vector[]/count array-arg call
    let hexagon: int[12];
    hexagon[0] = 460; hexagon[1] = 80;
    hexagon[2] = 520; hexagon[3] = 80;
    hexagon[4] = 550; hexagon[5] = 140;
    hexagon[6] = 520; hexagon[7] = 200;
    hexagon[8] = 460; hexagon[9] = 200;
    hexagon[10] = 430; hexagon[11] = 140;
    let purple: byte[4];
    purple[0] = 200; purple[1] = 122; purple[2] = 255; purple[3] = 255;
    draw_polygon(hexagon, 6, purple);

    // a circle sweeping left-to-right across the bottom, proving update()
    // is called repeatedly and state persists
    let x: int = frame % 600;
    draw_circle(x + 20, 350, 20, YELLOW);

    draw_text(FONT_DEFAULT, "shapes + animation + text", 20, 440, ORANGE);
}

