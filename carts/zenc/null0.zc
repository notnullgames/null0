// Constants
const SCREEN: Image = 0;
const SCREEN_WIDTH: int = 640;
const SCREEN_HEIGHT: int = 480;
const FONT_DEFAULT: Font = 0;

// Colors
const LIGHTGRAY = Color { r = 200, g = 200, b = 200, a = 255 };
const GRAY = Color { r = 130, g = 130, b = 130, a = 255 };
const DARKGRAY = Color { r = 80, g = 80, b = 80, a = 255 };
const YELLOW = Color { r = 253, g = 249, b = 0, a = 255 };
const GOLD = Color { r = 255, g = 203, b = 0, a = 255 };
const ORANGE = Color { r = 255, g = 161, b = 0, a = 255 };
const PINK = Color { r = 255, g = 109, b = 194, a = 255 };
const RED = Color { r = 230, g = 41, b = 55, a = 255 };
const MAROON = Color { r = 190, g = 33, b = 55, a = 255 };
const GREEN = Color { r = 0, g = 228, b = 48, a = 255 };
const LIME = Color { r = 0, g = 158, b = 47, a = 255 };
const DARKGREEN = Color { r = 0, g = 117, b = 44, a = 255 };
const SKYBLUE = Color { r = 102, g = 191, b = 255, a = 255 };
const BLUE = Color { r = 0, g = 121, b = 241, a = 255 };
const DARKBLUE = Color { r = 0, g = 82, b = 172, a = 255 };
const PURPLE = Color { r = 200, g = 122, b = 255, a = 255 };
const VIOLET = Color { r = 135, g = 60, b = 190, a = 255 };
const DARKPURPLE = Color { r = 112, g = 31, b = 126, a = 255 };
const BEIGE = Color { r = 211, g = 176, b = 131, a = 255 };
const BROWN = Color { r = 127, g = 106, b = 79, a = 255 };
const DARKBROWN = Color { r = 76, g = 63, b = 47, a = 255 };
const WHITE = Color { r = 255, g = 255, b = 255, a = 255 };
const BLACK = Color { r = 0, g = 0, b = 0, a = 255 };
const BLANK = Color { r = 0, g = 0, b = 0, a = 0 };
const MAGENTA = Color { r = 255, g = 0, b = 255, a = 255 };
const RAYWHITE = Color { r = 245, g = 245, b = 245, a = 255 };

// COLORS
// Tint a color with another color.
extern fn color_tint(color: Color, tint: Color) -> Color;
// Fade a color.
extern fn color_fade(color: Color, alpha: float) -> Color;
// Change the brightness of a color.
extern fn color_brightness(color: Color, factor: float) -> Color;
// Invert a color.
extern fn color_invert(color: Color) -> Color;
// Blend 2 colors together.
extern fn color_alpha_blend(dst: Color, src: Color) -> Color;
// Change contrast of a color.
extern fn color_contrast(color: Color, contrast: float) -> Color;
// Interpolate colors.
extern fn color_bilinear_interpolate(color00: Color, color01: Color, color10: Color, color11: Color, coordinateX: float, coordinateY: float) -> Color;

// GRAPHICS
// Create a new blank image.
extern fn new_image(width: int, height: int, color: Color) -> Image;
// Copy an image to a new image.
extern fn image_copy(image: Image) -> Image;
// Create an image from a region of another image.
extern fn image_subimage(image: Image, x: int, y: int, width: int, height: int) -> Image;
// Clear the screen.
extern fn clear(color: Color);
// Draw a single pixel on the screen.
extern fn draw_point(x: int, y: int, color: Color);
// Draw a line on the screen.
extern fn draw_line(startPosX: int, startPosY: int, endPosX: int, endPosY: int, color: Color);
// Draw a filled rectangle on the screen.
extern fn draw_rectangle(posX: int, posY: int, width: int, height: int, color: Color);
// Draw a filled triangle on the screen.
extern fn draw_triangle(x1: int, y1: int, x2: int, y2: int, x3: int, y3: int, color: Color);
// Draw a filled ellipse on the screen.
extern fn draw_ellipse(centerX: int, centerY: int, radiusX: int, radiusY: int, color: Color);
// Draw a filled circle on the screen.
extern fn draw_circle(centerX: int, centerY: int, radius: int, color: Color);
// Draw a filled polygon on the screen.
extern fn draw_polygon(points: *Vector, numPoints: int, color: Color);
// Draw a filled arc on the screen.
extern fn draw_arc(centerX: int, centerY: int, radius: float, startAngle: float, endAngle: float, segments: int, color: Color);
// Draw a filled round-rectangle on the screen.
extern fn draw_rectangle_rounded(x: int, y: int, width: int, height: int, cornerRadius: int, color: Color);
// Draw an image on the screen.
extern fn draw_image(src: Image, posX: int, posY: int);
// Draw a tinted image on the screen.
extern fn draw_image_tint(src: Image, posX: int, posY: int, tint: Color);
// Draw an image, rotated, on the screen.
extern fn draw_image_rotated(src: Image, posX: int, posY: int, degrees: float, offsetX: float, offsetY: float, filter: int);
// Draw an image, flipped, on the screen.
extern fn draw_image_flipped(src: Image, posX: int, posY: int, flipHorizontal: bool, flipVertical: bool, flipDiagonal: bool);
// Draw an image, scaled, on the screen.
extern fn draw_image_scaled(src: Image, posX: int, posY: int, scaleX: float, scaleY: float, offsetX: float, offsetY: float, filter: int);
// Draw some text on the screen.
extern fn draw_text(font: Font, text: *char, posX: int, posY: int, color: Color);
// Save an image to persistant storage.
extern fn save_image(image: Image, filename: *char);
// Load an image from a file in cart.
extern fn load_image(filename: *char) -> Image;
// Resize an image, return copy.
extern fn image_resize(image: Image, newWidth: int, newHeight: int, filter: int) -> Image;
// Scale an image, return copy.
extern fn image_scale(image: Image, scaleX: float, scaleY: float, filter: int) -> Image;
// Replace a color in an image, in-place.
extern fn image_color_replace(image: Image, color: Color, replace: Color);
// Tint a color in an image, in-place.
extern fn image_color_tint(image: Image, color: Color);
// Fade a color in an image, in-place.
extern fn image_color_fade(image: Image, alpha: float);
// Copy a font to a new font.
extern fn font_copy(font: Font) -> Font;
// Scale a font, return a new font.
extern fn font_scale(font: Font, scaleX: float, scaleY: float, filter: int) -> Font;
// Load a BMF font from a file in cart.
extern fn load_font_bmf(filename: *char, characters: *char) -> Font;
// Load a BMF font from an image.
extern fn load_font_bmf_from_image(image: Image, characters: *char) -> Font;
// Measure the size of some text.
extern fn measure_text(font: Font, text: *char, textLength: int) -> Dimensions;
// Meaure an image (use 0 for screen).
extern fn measure_image(image: Image) -> Dimensions;
// Load a TTY font from a file in cart.
extern fn load_font_tty(filename: *char, glyphWidth: int, glyphHeight: int, characters: *char) -> Font;
// Load a TTY font from an image.
extern fn load_font_tty_from_image(image: Image, glyphWidth: int, glyphHeight: int, characters: *char) -> Font;
// Load a TTF font from a file in cart.
extern fn load_font_ttf(filename: *char, fontSize: int) -> Font;
// Invert the colors in an image, in-place.
extern fn image_color_invert(image: Image);
// Calculate a rectangle representing the available alpha border in an image.
extern fn image_alpha_border(image: Image, threshold: float) -> Rectangle;
// Crop an image, in-place.
extern fn image_crop(image: Image, x: int, y: int, width: int, height: int);
// Crop an image based on the alpha border, in-place.
extern fn image_alpha_crop(image: Image, threshold: float);
// Adjust the brightness of an image, in-place.
extern fn image_color_brightness(image: Image, factor: float);
// Flip an image, in-place.
extern fn image_flip(image: Image, horizontal: bool, vertical: bool);
// Change the contrast of an image, in-place.
extern fn image_color_contrast(image: Image, contrast: float);
// Use an image as an alpha-mask on another image.
extern fn image_alpha_mask(image: Image, alphaMask: Image, posX: int, posY: int);
// Create a new image, rotating another image.
extern fn image_rotate(image: Image, degrees: float, filter: int) -> Image;
// Create a new image of a gradient.
extern fn image_gradient(width: int, height: int, topLeft: Color, topRight: Color, bottomLeft: Color, bottomRight: Color) -> Image;
// Unload an image.
extern fn unload_image(image: Image);
// Unload a font.
extern fn unload_font(font: Font);
// Clear an image.
extern fn clear_image(destination: Image, color: Color);
// Draw a single pixel on an image.
extern fn draw_point_on_image(destination: Image, x: int, y: int, color: Color);
// Draw a line on an image.
extern fn draw_line_on_image(destination: Image, startPosX: int, startPosY: int, endPosX: int, endPosY: int, color: Color);
// Draw a filled rectangle on an image.
extern fn draw_rectangle_on_image(destination: Image, posX: int, posY: int, width: int, height: int, color: Color);
// Draw a filled triangle on an image.
extern fn draw_triangle_on_image(destination: Image, x1: int, y1: int, x2: int, y2: int, x3: int, y3: int, color: Color);
// Draw a filled ellipse on an image.
extern fn draw_ellipse_on_image(destination: Image, centerX: int, centerY: int, radiusX: int, radiusY: int, color: Color);
// Draw a circle on an image.
extern fn draw_circle_on_image(destination: Image, centerX: int, centerY: int, radius: int, color: Color);
// Draw a filled polygon on an image.
extern fn draw_polygon_on_image(destination: Image, points: *Vector, numPoints: int, color: Color);
// Draw a filled round-rectangle on an image.
extern fn draw_rectangle_rounded_on_image(destination: Image, x: int, y: int, width: int, height: int, cornerRadius: int, color: Color);
// Draw an image on an image.
extern fn draw_image_on_image(destination: Image, src: Image, posX: int, posY: int);
// Draw a tinted image on an image.
extern fn draw_image_tint_on_image(destination: Image, src: Image, posX: int, posY: int, tint: Color);
// Draw an image, rotated, on an image.
extern fn draw_image_rotated_on_image(destination: Image, src: Image, posX: int, posY: int, degrees: float, offsetX: float, offsetY: float, filter: int);
// Draw an image, flipped, on an image.
extern fn draw_image_flipped_on_image(destination: Image, src: Image, posX: int, posY: int, flipHorizontal: bool, flipVertical: bool, flipDiagonal: bool);
// Draw an image, scaled, on an image.
extern fn draw_image_scaled_on_image(destination: Image, src: Image, posX: int, posY: int, scaleX: float, scaleY: float, offsetX: float, offsetY: float, filter: int);
// Draw some text on an image.
extern fn draw_text_on_image(destination: Image, font: Font, text: *char, posX: int, posY: int, color: Color);
// Draw a outlined (with thickness) rectangle on the screen.
extern fn draw_rectangle_outline(posX: int, posY: int, width: int, height: int, thickness: int, color: Color);
// Draw a outlined (with thickness) triangle on the screen.
extern fn draw_triangle_outline(x1: int, y1: int, x2: int, y2: int, x3: int, y3: int, thickness: int, color: Color);
// Draw a outlined (with thickness) ellipse on the screen.
extern fn draw_ellipse_outline(centerX: int, centerY: int, radiusX: int, radiusY: int, thickness: int, color: Color);
// Draw a outlined (with thickness) circle on the screen.
extern fn draw_circle_outline(centerX: int, centerY: int, radius: int, thickness: int, color: Color);
// Draw a outlined (with thickness) polygon on the screen.
extern fn draw_polygon_outline(points: *Vector, numPoints: int, thickness: int, color: Color);
// Draw a outlined (with thickness) arc on the screen.
extern fn draw_arc_outline(centerX: int, centerY: int, radius: float, startAngle: float, endAngle: float, segments: int, thickness: int, color: Color);
// Draw a outlined (with thickness) round-rectangle on the screen.
extern fn draw_rectangle_rounded_outline(x: int, y: int, width: int, height: int, cornerRadius: int, thickness: int, color: Color);
// Draw a outlined (with thickness) rectangle on an image.
extern fn draw_rectangle_outline_on_image(destination: Image, posX: int, posY: int, width: int, height: int, thickness: int, color: Color);
// Draw a outlined (with thickness) triangle on an image.
extern fn draw_triangle_outline_on_image(destination: Image, x1: int, y1: int, x2: int, y2: int, x3: int, y3: int, thickness: int, color: Color);
// Draw a outlined (with thickness) ellipse on an image.
extern fn draw_ellipse_outline_on_image(destination: Image, centerX: int, centerY: int, radiusX: int, radiusY: int, thickness: int, color: Color);
// Draw a outlined (with thickness) circle on an image.
extern fn draw_circle_outline_on_image(destination: Image, centerX: int, centerY: int, radius: int, thickness: int, color: Color);
// Draw a outlined (with thickness) polygon on an image.
extern fn draw_polygon_outline_on_image(destination: Image, points: *Vector, numPoints: int, thickness: int, color: Color);
// Draw a outlined (with thickness) round-rectangle on an image.
extern fn draw_rectangle_rounded_outline_on_image(destination: Image, x: int, y: int, width: int, height: int, cornerRadius: int, thickness: int, color: Color);

// GUI
// Begin a GUI window. Returns false if the window is collapsed or closed - skip its contents, but still call gui_end_window.
extern fn gui_begin_window(title: *char, rect: Rectangle) -> bool;
// End the current GUI window.
extern fn gui_end_window();
// A button. Returns true when it is clicked.
extern fn gui_button(label: *char) -> bool;
// A static text label.
extern fn gui_label(text: *char);
// A block of wrapping text.
extern fn gui_text(text: *char);
// A checkbox. Returns the (possibly changed) state.
extern fn gui_checkbox(label: *char, state: bool) -> bool;
// A slider. Returns the (possibly changed) value.
extern fn gui_slider(value: float, low: float, high: float) -> float;
// Set the current layout row - the column widths (negative for flexible), and the row height.
extern fn gui_layout_row(widths: *int, numWidths: int, height: int);
// Finish building the GUI for this frame. Called automatically at the end of update if you do not call it.
extern fn gui_end();
// Draw the GUI to an image (0 is the screen).
extern fn gui_draw(dst: Image);

// INPUT
// Has the key been pressed? (tracks unpress/read correctly.)
extern fn key_pressed(key: int) -> bool;
// Is the key currently down?
extern fn key_down(key: int) -> bool;
// Has the key been released? (tracks press/read correctly.)
extern fn key_released(key: int) -> bool;
// Is the key currently up?
extern fn key_up(key: int) -> bool;
// Has the button been pressed? (tracks unpress/read correctly.)
extern fn gamepad_button_pressed(gamepad: int, button: int) -> bool;
// Is the button currently down?
extern fn gamepad_button_down(gamepad: int, button: int) -> bool;
// Has the button been released? (tracks press/read correctly.)
extern fn gamepad_button_released(gamepad: int, button: int) -> bool;
// Get current position of mouse.
extern fn mouse_position() -> Vector;
// Has the button been pressed? (tracks unpress/read correctly.)
extern fn mouse_button_pressed(button: int) -> bool;
// Is the button currently down?
extern fn mouse_button_down(button: int) -> bool;
// Has the button been released? (tracks press/read correctly.)
extern fn mouse_button_released(button: int) -> bool;
// Is the button currently up?
extern fn mouse_button_up(button: int) -> bool;

// SOUND
// Load a sound from a file in cart.
extern fn load_sound(filename: *char) -> Sound;
// Play a sound.
extern fn play_sound(sound: Sound, loop: bool);
// Stop a sound.
extern fn stop_sound(sound: Sound);
// Unload a sound.
extern fn unload_sound(sound: Sound);
// Speak some text and return a sound. Set things to 0 for defaults.
extern fn tts_sound(text: *char, phonetic: bool, pitch: int, speed: int, throat: int, mouth: int, sing: bool) -> Sound;
// Create Sfx sound.
extern fn sfx_sound(params: *SfxParams) -> Sound;
// Create Sfx parameters.
extern fn sfx_generate(type: int) -> *SfxParams;

// TILE
// Load a tilemap (a Tiled map, exported as JSON) from a file in cart.
extern fn load_tilemap(filename: *char) -> Tilemap;
// Unload a tilemap.
extern fn unload_tilemap(tilemap: Tilemap);
// Update a tilemap's animation timers (deltaTime is in seconds).
extern fn tile_update(tilemap: Tilemap, deltaTime: float);
// Draw a tilemap on the screen.
extern fn tile_draw(tilemap: Tilemap, posX: int, posY: int);
// Draw a tilemap on the screen, tinted by a color.
extern fn tile_draw_tint(tilemap: Tilemap, posX: int, posY: int, tint: Color);
// Draw a tilemap on an image.
extern fn tile_draw_on_image(dst: Image, tilemap: Tilemap, posX: int, posY: int);
// Draw a single tile from a tilemap on the screen.
extern fn tile_draw_tile(tilemap: Tilemap, gid: int, posX: int, posY: int);
// Get the number of layers in a tilemap.
extern fn tile_layer_count(tilemap: Tilemap) -> int;
// Get the gid of the tile at a column/row in a tilemap layer.
extern fn tile_get_tile(tilemap: Tilemap, layer: int, column: int, row: int) -> int;
// Set the gid of the tile at a column/row in a tilemap layer.
extern fn tile_set_tile(tilemap: Tilemap, layer: int, column: int, row: int, gid: int);
// Get a copy of the image of a single tile in a tilemap.
extern fn tile_image(tilemap: Tilemap, gid: int) -> Image;
// Render a whole tilemap to a new image.
extern fn tilemap_image(tilemap: Tilemap) -> Image;

// TYPES

// UTILITIES
// Get system-time (ms) since unix epoch.
extern fn current_time() -> ulong;
// Get the change in time (seconds) since the last update run.
extern fn delta_time() -> float;
// Get a random integer between 2 numbers.
extern fn random_int(min: int, max: int) -> int;
// Get the random-seed.
extern fn random_seed_get() -> ulong;
// Set the random-seed.
extern fn random_seed_set(seed: ulong);

// Callbacks (cart exports)
export fn load();
export fn update();
export fn unload();
// Mapped controller (keys and gamepad will trigger) callback for when a "button" is unpressed.
export fn buttonUp(button: int, player: uint);
// Mapped controller (keys and gamepad will trigger) callback for when a "button" is pressed.
export fn buttonDown(button: int, player: uint);
// Called when keys are unpressed.
export fn keyUp(key: int);
// Called when keys are pressed.
export fn keyDown(key: int);
// Called when mouse-button is pressed.
export fn mouseDown(button: int);
// Called when mouse-button is released.
export fn mouseUp(button: int);
// Called when mouse is moved.
export fn mouseMoved(x: float, y: float);
