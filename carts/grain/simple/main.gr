module Main

from "runtime/unsafe/wasmi32" include WasmI32
from "./null0.gr" include Null0

// grain numbers cross the boundary as raw wasm values, so they're written
// `100n`. Colors and strings are pointers into memory - initColors() fills in
// the color constants, and the text bytes go in by hand just below.
@unsafe
provide let load = () => {
  Null0.initColors()

  // past the color constants; null-terminated, like any C string
  let textPtr = 65700n
  WasmI32.store8(textPtr, 104n, 0n)
  WasmI32.store8(textPtr, 101n, 1n)
  WasmI32.store8(textPtr, 108n, 2n)
  WasmI32.store8(textPtr, 108n, 3n)
  WasmI32.store8(textPtr, 111n, 4n)
  WasmI32.store8(textPtr, 32n, 5n)
  WasmI32.store8(textPtr, 102n, 6n)
  WasmI32.store8(textPtr, 114n, 7n)
  WasmI32.store8(textPtr, 111n, 8n)
  WasmI32.store8(textPtr, 109n, 9n)
  WasmI32.store8(textPtr, 32n, 10n)
  WasmI32.store8(textPtr, 71n, 11n)
  WasmI32.store8(textPtr, 114n, 12n)
  WasmI32.store8(textPtr, 97n, 13n)
  WasmI32.store8(textPtr, 105n, 14n)
  WasmI32.store8(textPtr, 110n, 15n)
  WasmI32.store8(textPtr, 0n, 16n)

  Null0.clear(Null0.blue)
  Null0.draw_circle(100n, 100n, 50n, Null0.red)
  Null0.draw_text(0n, textPtr, 170n, 92n, Null0.white)
}

provide let update = () => void
