// simple jik cart for null0
//
// Jik has no u8/f32/uint, no pointer types and no string type, so it cannot
// name null0's Color (four bytes) or pass a char*. The pattern is a small C
// wrapper in an @embed block that builds those and calls through - see
// carts/jik/null0.jik for the full list of declarations to copy from.
//
// That's why the text lives in C here: `text: *char` and `text: string` are
// both rejected by the jik parser, so the literal can't cross the boundary.

@embed{C_END}
#include "null0.h"

static void jik_clear(int r, int g, int b, int a) {
    Color c = { (unsigned char)r, (unsigned char)g, (unsigned char)b, (unsigned char)a };
    clear(c);
}
static void jik_draw_circ(int cx, int cy, int rad, int r, int g, int b, int a) {
    Color c = { (unsigned char)r, (unsigned char)g, (unsigned char)b, (unsigned char)a };
    draw_circle(cx, cy, rad, c);
}
static void jik_draw_hello(int x, int y, int r, int g, int b, int a) {
    Color c = { (unsigned char)r, (unsigned char)g, (unsigned char)b, (unsigned char)a };
    draw_text(FONT_DEFAULT, "hello from Jik", x, y, c);
}
C_END

extern func jik_clear as clear(r: int, g: int, b: int, a: int) -> void
extern func jik_draw_circ as draw_circle(cx: int, cy: int, rad: int, r: int, g: int, b: int, a: int) -> void
extern func jik_draw_hello as draw_hello(x: int, y: int, r: int, g: int, b: int, a: int) -> void

func load():
    clear(0, 121, 241, 255)
    draw_circle(100, 100, 50, 230, 41, 55, 255)
    draw_hello(170, 92, 255, 255, 255, 255)
end

// jik needs a main, even though null0 never calls it
func main():
end
