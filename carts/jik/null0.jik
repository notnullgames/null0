// DARKBROWN: r=76, g=63, b=47, a=255
// WHITE: r=255, g=255, b=255, a=255
// BLACK: r=0, g=0, b=0, a=255
// BLANK: r=0, g=0, b=0, a=0
// MAGENTA: r=255, g=0, b=255, a=255
// RAYWHITE: r=245, g=245, b=245, a=255

