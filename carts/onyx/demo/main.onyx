#load "null0.onyx"
use core.string {str}

// onyx needs a main, null0 will call load/update/etc itself
main :: () {}

// persistent frame counter, incremented once per update()
frame : i32 = 0;

hexagon : [6] Vector;

update :: () {
    clear(DARKGRAY);

    title := str.to_cstr_on_stack("null0 demo");
    draw_text(FONT_DEFAULT, cast(u32) title, 20, 20, WHITE);

    draw_rectangle(40, 80, 100, 70, RED);
    draw_circle(220, 115, 45, GREEN);
    draw_triangle(320, 150, 400, 150, 360, 60, BLUE);
    draw_line(40, 250, 600, 250, LIGHTGRAY);

    // hexagon - a fixed array of Vector structs
    hexagon[0] = Vector.{ 460, 80 };
    hexagon[1] = Vector.{ 520, 80 };
    hexagon[2] = Vector.{ 550, 140 };
    hexagon[3] = Vector.{ 520, 200 };
    hexagon[4] = Vector.{ 460, 200 };
    hexagon[5] = Vector.{ 430, 140 };
    draw_polygon(cast(u32) ^hexagon[0], 6, PURPLE);

    frame += 1;
    x := frame % 600;
    draw_circle(x + 20, 350, 20, YELLOW);

    footer := str.to_cstr_on_stack("shapes + animation + text");
    draw_text(FONT_DEFAULT, cast(u32) footer, 20, 440, ORANGE);
}
#export "update" update

